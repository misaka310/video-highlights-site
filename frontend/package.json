{
  "name": "video-highlights-site-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 4174",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test:unit": "tsc -p tsconfig.unit.json && node --test .unit-test-dist/tests/unit/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "hls.js": "^1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fast-check": "4.10.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7"
  }
}
