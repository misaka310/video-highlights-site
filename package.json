{
  "name": "video-highlights-site",
  "version": "2.0.0",
  "description": "Static video highlights site",
  "private": true,
  "scripts": {
    "dev": "node frontend/node_modules/vite/bin/vite.js frontend --host localhost --port 4174 --strictPort",
    "start": "node frontend/node_modules/vite/bin/vite.js frontend --host localhost --port 4174 --strictPort",
    "setup": "python scripts/setup_dependencies.py",
    "build": "npm run build:public",
    "build:public": "sh scripts/build_public.sh",
    "typecheck": "python scripts/verify.py --step typecheck",
    "typecheck:frontend": "python scripts/verify.py --step typecheck",
    "lint": "python scripts/verify.py --step lint",
    "lint:frontend": "python scripts/verify.py --step lint",
    "test": "python scripts/verify.py",
    "test:frontend:unit": "python scripts/verify.py --step frontend-unit",
    "test:frontend:e2e": "python scripts/verify.py --step frontend-e2e",
    "test:python": "python scripts/verify.py --step python",
    "test:public": "python scripts/verify.py --step public-e2e",
    "test:live:youtube": "python scripts/verify.py --step live-youtube",
    "test:live:production": "python scripts/verify.py --step live-production",
    "check:public": "python scripts/verify.py --step public-checks",
    "check:live": "python scripts/verify.py --step live-data",
    "check:repo-hygiene": "python scripts/verify.py --step hygiene",
    "verify": "python scripts/verify.py",
    "verify:browser": "python scripts/verify.py --step browser",
    "verify:live": "python scripts/verify.py --step live",
    "verify:live:browser": "python scripts/verify.py --step live-browser",
    "test:e2e": "python scripts/verify.py --step frontend-e2e"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
